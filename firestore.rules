rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Token Asesmen Siswa (6 Karakter Huruf & Angka) =====
    match /assessment_tokens/{tokenId} {
      allow read, write: if true;
    }

    // ===== Laporan & Rekam Medis Hasil Asesmen =====
    match /assessments/{reportId} {
      allow read, write: if true;
    }

    // ===== Kontak Darurat Krisis =====
    match /crisis_contacts/{contactId} {
      allow read, write: if true;
    }

    // ===== Catatan Intervensi & Konseling Guru BK =====
    match /interventions/{interventionId} {
      allow read, write: if true;
    }

    // ===== Bank Soal & Media Asesmen (DASS-42 & DCM) =====
    match /assessment_questions/{questionId} {
      allow read, write: if true;
    }

    // ===== Akun Administrator & Guru BK =====
    match /admin_users/{userId} {
      allow read, write: if true;
    }

    // ===== Log Audit Aktivitas =====
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
